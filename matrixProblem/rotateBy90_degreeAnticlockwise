// GFG PROBLEM:
// Approach:
// 1. First transpose the matrix by swapping elements at positions (i, j)
//    with (j, i). This converts rows into columns and columns into rows.
// 2. After transposing, reverse the order of rows by swapping the first
//    row with the last row, the second row with the second last row, and so on.
// 3. This rotates the matrix by 90 degrees anticlockwise.
//
// Time Complexity:
// - Transpose takes O(N²).
// - Reversing the rows takes O(N²).
// Therefore, overall TC = O(N²) + O(N²) = O(2N²) = O(N²).
//
// Space Complexity:
// O(1), since the rotation is performed in-place.

class Solution 
{
    //Function to rotate matrix anticlockwise by 90 degrees.
    rotateby90(matrix, n) 
    { 
        for(let i=0;i<matrix.length;i++){
            for(let j=0;j<=i;j++){
                let temp = matrix[i][j];
                matrix[i][j] = matrix[j][i];
                matrix[j][i] = temp;
            }
        }
        
        
        for(let i=0;i<(n/2);i++){
            for(let j=0;j<n;j++){
                let temp = matrix[i][j];
                matrix[i][j] = matrix[n-i-1][j];
                matrix[n-i-1][j] = temp;
            }
        }
    } 
}