// Leetcode Problem:
// Approach:-
// First, iterate through each row of the given grid (matrix).
// While iterating through each row of the given matrix, use a Set to keep track of
// the values encountered in the current row. Meanwhile, check if the current
// iterated value is already present in the Set. If it is already present,
// return false immediately because the row contains a duplicate.
// Otherwise, add the value to the Set.
//
// Likewise, iterate through each column of the given grid (matrix).
// While iterating through each column, again use a Set to keep track of the
// values encountered in the current column. If the current iterated value is
// already present in the Set, return false immediately because the column
// contains a duplicate. Otherwise, add the value to the Set.
//
// There are nine 3x3 sub-matrices in a 9x9 Sudoku board.
// Iterate over each 3x3 sub-matrix by moving in steps of 3
// (i.e., i += 3 and j += 3).
// Use a Set to track the numbers encountered in the current sub-matrix.
//
// For each cell in the current 3x3 sub-matrix, check if the number is already
// present in the Set. If the number is already in the Set, the sub-matrix
// contains a duplicate, so return false.
// If the number is not in the Set, add it to the Set.
//
// Time Complexity:
// The time complexity is O(1) because we are iterating over a fixed number
// of cells (81), as the Sudoku board always contains 9 rows and 9 columns.
//
// Space Complexity:
// The space complexity is O(1) because we are using a fixed amount of
// additional space. The Set can contain at most 9 values at a time.

var isValidSudoku = function (board) {
    let row = board.length;
    let col = board[0].length;

    //Check for rows that it contain any duplicate or not
    for (let i = 0; i < row; i++) {
        let set = new Set();
        let count = 0;
        for (let j = 0; j < col; j++) {
            if (board[i][j] != ".") {
                if (set.has(board[i][j])) {
                    return false;
                } else {
                    set.add(board[i][j])
                }
            }
        }
    }

//Check for columns that it contain any duplicate or not
for (let j = 0; j < col; j++) {
    let set = new Set();
    for (let i = 0; i < row; i++) {
        if (board[i][j] != ".") {
            if (set.has(board[i][j])) {
                return false;
            } else {
                set.add(board[i][j])
            }
        }
    }
}


// Check for each 3x3 sub-matrix that it contain any duplicate or not
for (let i = 0; i < row; i += 3) {
    for (let j = 0; j < col; j += 3) {
        let set = new Set();
        for (let k = i; k < i+3; k++) {
            for (let l = j; l < j+3; l++) {
                let value = board[k][l];
                if (value != ".") {
                    if (set.has(value)) {
                        return false;
                    }
                    set.add(value);
                }
            }
        }
    }
}


return true;
};